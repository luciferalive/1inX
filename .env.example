# Copy this file to .env and fill in your own Supabase project values.
# Find them in Supabase → Project Settings → API.

# --- Browser + server (public) ---
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-public-anon-key"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# --- Server-side (SSR) copies of the same public values ---
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-public-anon-key"
SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# --- SECRET: server only. Never commit, never expose to the browser. ---
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
